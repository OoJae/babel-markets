# Babel Markets, environment template.
# Copy this to .env.local and fill in every value before running `npm run dev`.
# See SETUP.md for the step-by-step on where each key comes from.

# ---------- App ----------
# Production: your Vercel URL (no trailing slash). Local: leave empty.
NEXT_PUBLIC_VERCEL_URL=

# ---------- Supabase ----------
# From https://app.supabase.com -> project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Circle ----------
# From https://console.circle.com/apikeys
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Modular Wallets passkey transport (client side, public)
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=

# ---------- Agent inference ----------
# From https://console.anthropic.com (separate from your Claude Code key)
ANTHROPIC_API_KEY=

# ---------- Observability ----------
# From https://cloud.langfuse.com -> project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Redis ----------
# From https://console.upstash.com -> create a Redis database -> REST URL/Token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- IPFS proof ----------
# Private key of an EVM wallet funded with a small amount of MATIC for Irys uploads
IRYS_PRIVATE_KEY=

# ---------- Chains ----------
# Arc testnet RPC (default works without override)
ARC_RPC_URL=https://rpc.testnet.arc.network
# Polygon Amoy testnet RPC, see https://www.alchemy.com/chain-connect/chain/polygon-amoy
POLYGON_RPC_URL=
# Agent EOA: a fresh wallet that funds Gateway Nanopayments AND initiates CCTP sweeps.
# Generate with `openssl rand -hex 32` and fund with testnet USDC + a tiny bit of MATIC.
AGENT_EOA_PRIVATE_KEY=
# Set after deploying AttributionEscrow.sol to Arc testnet in Phase 5
ATTRIBUTION_ESCROW_ADDRESS=

# ---------- Polymarket ----------
# From https://docs.polymarket.com (host) and your builder profile (code)
POLYMARKET_API_HOST=https://clob.polymarket.com
POLYMARKET_BUILDER_CODE=
# Signer key for posting orders. KEEP SEPARATE FROM AGENT_EOA_PRIVATE_KEY in production.
POLYMARKET_SIGNER_KEY=
