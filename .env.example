# Babel Markets, environment template.
# Copy this to .env.local and fill in every value before running `npm run dev`.
# See SETUP.md for the step-by-step on where each key comes from.

# ---------- App ----------
# Production: your Vercel URL (no trailing slash). Local: leave empty.
NEXT_PUBLIC_VERCEL_URL=

# ---------- Brand landing AgentDemo ----------
# Controls the live agent demo on the marketing landing at "/".
# "1" (default): the AgentDemo POSTs to /api/agent/stream and renders the real
#   pipeline output. If the stream errors, falls back to the canned simulated
#   run so the demo always finishes.
# "0": always runs the canned 7-step simulation with the SAMPLES result. Use
#   this for the video shoot so nothing depends on the live pipeline.
NEXT_PUBLIC_USE_LIVE_AGENT=1

# ---------- Supabase ----------
# From https://app.supabase.com -> project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Circle ----------
# From https://console.circle.com/apikeys
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Modular Wallets passkey transport (client side, public)
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=

# ---------- Agent inference ----------
# ANTHROPIC_API_KEY can point at the real Anthropic API or any Anthropic-compatible
# gateway (e.g. MiMo). If using a gateway, set ANTHROPIC_BASE_URL too.
ANTHROPIC_API_KEY=
# Optional: override the Anthropic base URL when routing through a gateway like MiMo.
# Leave empty to hit Anthropic directly. Example: https://your-mimo-gateway.example.com
ANTHROPIC_BASE_URL=
# Model id. For MiMo, "mimo-v2.5-pro". For Anthropic native, "claude-sonnet-4-6".
AGENT_MODEL=mimo-v2.5-pro
# Pricing per 1M input/output tokens for the AGENT_MODEL, used for the on-screen
# per-question cost readout. Cents-per-million ok, USD-per-million ok; be consistent.
AGENT_MODEL_INPUT_PRICE_PER_M=3
AGENT_MODEL_OUTPUT_PRICE_PER_M=15
# Optional, only set if the gateway exposes a separate embeddings endpoint with a
# different model name. If empty, the agent probes /v1/embeddings on the base URL.
AGENT_EMBED_MODEL=

# ---------- Embeddings ----------
# Voyage AI key for remote embeddings (https://dash.voyageai.com). Required for
# Vercel deploys because the local Xenova fallback needs libonnxruntime.so which
# is not available in Vercel's serverless runtime. Free tier covers hackathon
# volume. We request voyage-3-large with output_dimension=384 to match the
# existing pgvector column.
VOYAGE_API_KEY=

# ---------- Observability ----------
# From https://cloud.langfuse.com -> project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Redis ----------
# From https://console.upstash.com -> create a Redis database -> REST URL/Token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- IPFS proof ----------
# Private key of an EVM wallet funded with a small amount of MATIC for Irys uploads
IRYS_PRIVATE_KEY=

# ---------- Chains ----------
# Arc testnet RPC (default works without override)
ARC_RPC_URL=https://rpc.testnet.arc.network
# Polygon Amoy testnet RPC, see https://www.alchemy.com/chain-connect/chain/polygon-amoy
POLYGON_RPC_URL=
# Agent EOA: a fresh wallet that funds Gateway Nanopayments AND initiates CCTP sweeps.
# Generate with `openssl rand -hex 32` and fund with testnet USDC + a tiny bit of MATIC.
AGENT_EOA_PRIVATE_KEY=
# Set after deploying AttributionEscrow.sol to Arc testnet in Phase 5
# (`npx tsx scripts/compile-escrow.ts && npx tsx scripts/deploy-escrow.ts`)
ATTRIBUTION_ESCROW_ADDRESS=

# ---------- CCTP v2 (Polygon Amoy -> Arc Testnet) ----------
# Flip to "1" after the agent EOA has testnet USDC on Polygon Amoy and a tiny
# amount of MATIC for gas. When 0, the dashboard "Sweep to Arc" button uses a
# mocked 4-event sequence with fake tx hashes so the UI flow is demoable
# without burning testnet credits.
BABEL_CCTP_ENABLED=0

# ---------- Gateway Nanopayments ----------
# Flip to "1" once the agent EOA has been funded via scripts/fund-agent-eoa.ts.
# When 0, each agent step skips the Nanopayment and the UI shows "Nanopayments off".
BABEL_NANOPAYMENTS_ENABLED=0
# Amount the agent pays per inference call in USDC (decimal string).
# 0.001 = 1/10 of a cent. If Circle's facilitator rejects amounts this small,
# step up to 0.01 and update the demo line.
NANOPAYMENT_PRICE_USDC=0.001
# Circle facilitator URL. Testnet by default; do not switch to mainnet without
# explicit go-ahead.
NANOPAYMENT_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# Recipient address for the Nanopayment. Defaults to the agent EOA itself
# (self-payment is fine for the demo; we own both sides of the flow).
NANOPAYMENT_SELLER_ADDRESS=
# Optional override when the seller route is hosted on a different domain than
# the agent runs from. Used by lib/agent/gated-call.ts to construct the URL.
BABEL_PUBLIC_URL=

# ---------- Polymarket ----------
# From https://docs.polymarket.com (host) and your builder profile (code)
POLYMARKET_API_HOST=https://clob.polymarket.com
# Optional override for the Gamma metadata API
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
# Builder code from https://builders.polymarket.com (stays empty until verified-tier approval)
POLYMARKET_BUILDER_CODE=
# Signer key for posting orders. KEEP SEPARATE FROM AGENT_EOA_PRIVATE_KEY in production.
POLYMARKET_SIGNER_KEY=
# Set to "1" only after the builder code is approved AND the signer wallet is funded
# with real USDC on Polygon mainnet. Default 0 keeps the app in preview-only mode.
POLYMARKET_LIVE_POSTING=0
# Builder fee share in basis points; placeholder until Polymarket publishes the exact rate.
POLYMARKET_FEE_BPS=100
# Polymarket CTF Exchange (V2 domain), Polygon mainnet
POLYGON_CTF_EXCHANGE_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B

# ---------- USYC sandbox (Circle hackathon access) ----------
# Empty = stub mode (deterministic mocks, no API call). Once Circle delivers
# the hackathon sandbox key, drop it here + set NEXT_PUBLIC_USYC_LIVE=1 so the
# dashboard badge flips to "sandbox live" and subscribe/redeem hit the real
# Teller. Apply for access at https://docs.circle.com/usyc or the form
# linked from the Circle hackathon page.
USYC_API_KEY=
USYC_API_BASE_URL=https://api-sandbox.usyc.circle.com/v1
# Public mirror of USYC_API_KEY. Set to "1" only when the server key is real.
NEXT_PUBLIC_USYC_LIVE=0
